      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(db_pool_wait_seconds_bucket[$__rate_interval])) by (le, op))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "title": "DB Pool Wait p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (op) (rate(db_req_total[$__rate_interval]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "title": "DBAgent Request Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (op, reason) (rate(db_req_failure_total[$__rate_interval]))",
          "legendFormat": "{{op}}/{{reason}}",
          "refId": "A"
        }
      ],
      "title": "DBAgent Request Failures",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "db_pool_size",
          "legendFormat": "pool_size",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "db_pool_inuse",
          "legendFormat": "pool_inuse",
          "refId": "B"
        }
      ],
      "title": "DB Pool Size vs InUse",
      "type": "timeseries"
    }
