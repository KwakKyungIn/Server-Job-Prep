          "legendFormat": "Dirty Set - QuickSlot",
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_persistence_mutation_total{domain=\"qs\",path=\"writeback\"}[$__rate_interval]))",
          "legendFormat": "QuickSlot Mutations - Writeback",
          "refId": "D"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_persistence_mutation_total{domain=\"qs\",path=\"immediate\"}[$__rate_interval]))",
          "legendFormat": "QuickSlot Mutations - Immediate",
          "refId": "E"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_autocommit_skip_total{reason=\"inflight\"}[$__rate_interval]))",
