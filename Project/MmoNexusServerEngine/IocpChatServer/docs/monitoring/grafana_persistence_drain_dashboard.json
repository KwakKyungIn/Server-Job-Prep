      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(gs_dirty_set_size{domain=\"player\"})",
          "legendFormat": "Dirty Set - Player",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "max(gs_dirty_set_size{domain=\"inv\"})",
