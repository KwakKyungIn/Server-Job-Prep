{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Portfolio dashboard for Hot Room Mix A/B tests comparing final AOI mode against room-wide baseline mode.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "gs_ccu",
          "legendFormat": "Connected Sessions",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "gs_ingame_players",
          "legendFormat": "Ingame Players",
          "refId": "B"
        }
      ],
      "title": "Load Status: Sessions vs Players",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_broadcast_recipients_bucket{kind=\"move\",mode=\"aoi\"}[$__rate_interval])) by (le))",
          "legendFormat": "Move - AOI",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_broadcast_recipients_bucket{kind=\"move\",mode=\"room\"}[$__rate_interval])) by (le))",
          "legendFormat": "Move - Room Wide",
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_broadcast_recipients_bucket{kind=\"skill\",mode=\"aoi\"}[$__rate_interval])) by (le))",
          "legendFormat": "Skill - AOI",
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_broadcast_recipients_bucket{kind=\"skill\",mode=\"room\"}[$__rate_interval])) by (le))",
          "legendFormat": "Skill - Room Wide",
          "refId": "D"
        }
      ],
      "title": "Broadcast Fan-out p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_session_tx_bytes_total[$__rate_interval]))",
          "legendFormat": "Server TX",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_session_rx_bytes_total[$__rate_interval]))",
          "legendFormat": "Server RX",
          "refId": "B"
        }
      ],
      "title": "Session Traffic: TX vs RX",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_jobqueue_wait_seconds_bucket{queue=\"job\"}[$__rate_interval])) by (le))",
          "legendFormat": "Room Wait p95",
          "refId": "A"
        }
      ],
      "title": "Room Queue Wait p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_jobqueue_exec_seconds_bucket{queue=\"job\"}[$__rate_interval])) by (le))",
          "legendFormat": "Job Exec p95",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_packet_handle_seconds_bucket{op=\"move\"}[$__rate_interval])) by (le))",
          "legendFormat": "Move Handle p95",
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_packet_handle_seconds_bucket{op=\"skill\"}[$__rate_interval])) by (le))",
          "legendFormat": "Skill Handle p95",
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_aoi_update_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "AOI Update p95",
          "refId": "D"
        }
      ],
      "title": "Key Processing Latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "gs_ccu",
          "legendFormat": "Connected Sessions",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "gs_ingame_players",
          "legendFormat": "Ingame Players",
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_broadcast_recipients_bucket{kind=\"move\",mode=\"aoi\"}[$__rate_interval])) by (le))",
          "legendFormat": "Broadcast p95 - Move AOI",
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_broadcast_recipients_bucket{kind=\"move\",mode=\"room\"}[$__rate_interval])) by (le))",
          "legendFormat": "Broadcast p95 - Move Room Wide",
          "refId": "D"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_broadcast_recipients_bucket{kind=\"skill\",mode=\"aoi\"}[$__rate_interval])) by (le))",
          "legendFormat": "Broadcast p95 - Skill AOI",
          "refId": "E"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_broadcast_recipients_bucket{kind=\"skill\",mode=\"room\"}[$__rate_interval])) by (le))",
          "legendFormat": "Broadcast p95 - Skill Room Wide",
          "refId": "F"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_session_tx_bytes_total[$__rate_interval]))",
          "legendFormat": "Session TX Bps",
          "refId": "G"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_session_rx_bytes_total[$__rate_interval]))",
          "legendFormat": "Session RX Bps",
          "refId": "H"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_jobqueue_wait_seconds_bucket{queue=\"job\"}[$__rate_interval])) by (le))",
          "legendFormat": "Room Wait p95 sec",
          "refId": "I"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_jobqueue_exec_seconds_bucket{queue=\"job\"}[$__rate_interval])) by (le))",
          "legendFormat": "Room Exec p95 sec",
          "refId": "J"
        },
        {
          "editorMode": "code",
          "expr": "max(gs_jobqueue_depth{queue=\"job\"})",
          "legendFormat": "Room Queue Depth max",
          "refId": "K"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_worker_exec_seconds_total{type=\"logic\"}[$__rate_interval])) / clamp_min(sum(rate(gs_worker_exec_seconds_total{type=\"logic\"}[$__rate_interval])) + sum(rate(gs_worker_idle_seconds_total{type=\"logic\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "Worker Busy Ratio",
          "refId": "L"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_packet_ingress_total[$__rate_interval]))",
          "legendFormat": "Packet Ingress total rps",
          "refId": "M"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_packet_ingress_total{op=\"move\"}[$__rate_interval]))",
          "legendFormat": "Packet Ingress move rps",
          "refId": "N"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_packet_ingress_total{op=\"skill\"}[$__rate_interval]))",
          "legendFormat": "Packet Ingress skill rps",
          "refId": "O"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_packet_failure_total[$__rate_interval]))",
          "legendFormat": "Packet Failure rps",
          "refId": "P"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_packet_handle_seconds_bucket{op=\"move\"}[$__rate_interval])) by (le))",
          "legendFormat": "Move Handle p95 sec",
          "refId": "Q"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_packet_handle_seconds_bucket{op=\"skill\"}[$__rate_interval])) by (le))",
          "legendFormat": "Skill Handle p95 sec",
          "refId": "R"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_aoi_update_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "AOI Update p95 sec",
          "refId": "S"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_aoi_update_total[$__rate_interval]))",
          "legendFormat": "AOI Update rps",
          "refId": "T"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_aoi_candidates_bucket{kind=\"player\"}[$__rate_interval])) by (le))",
          "legendFormat": "AOI Candidates p95 - Player",
          "refId": "U"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gs_aoi_visible_bucket{kind=\"player\"}[$__rate_interval])) by (le))",
          "legendFormat": "AOI Visible p95 - Player",
          "refId": "V"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(gs_session_send_drop_total[$__rate_interval]))",
          "legendFormat": "Session Send Drop rps",
          "refId": "W"
        }
      ],
      "title": "CSV Export: Hot Room Major Signals",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "gameserver",
    "prometheus",
    "hot-room",
    "portfolio"
  ],
